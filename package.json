{
  "name": "khmer-text-to-speech",
  "version": "2.0.0",
  "description": "Convert Khmer text to natural-sounding speech using Microsoft Edge TTS",
  "type": "module",
  "private": true,
  "author": "Keosovanmakara",
  "license": "MIT",
  "keywords": [
    "khmer",
    "tts",
    "text-to-speech",
    "edge-tts",
    "cambodia",
    "speech-synthesis"
  ],
  "scripts": {
    "voices": "tsx src/index.ts voices",
    "generate": "tsx src/index.ts generate",
    "serve": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "start": "npm run serve",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "tsx tests/subtitle.test.ts",
    "test:api": "vitest run tests/api.test.ts",
    "clean": "node -e \"require('fs').rmSync('output', {recursive:true,force:true})\" && node -e \"require('fs').rmSync('dist', {recursive:true,force:true})\"",
    "build": "tsc",
    "db:backup": "tsx scripts/db-backup.ts backup",
    "db:restore": "tsx scripts/db-backup.ts restore",
    "db:list": "tsx scripts/db-backup.ts list",
    "loadtest": "node scripts/load-test.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@andresaya/edge-tts": "^1.8.0",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^25.9.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.2.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
